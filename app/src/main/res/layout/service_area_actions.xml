<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="16dp" android:orientation="horizontal">
    <com.google.android.material.button.MaterialButton android:id="@+id/areaCancel"
        style="@style/MapFlowButton.Outline" android:layout_width="0dp" android:layout_weight="1"
        android:text="Cancel" />
    <com.google.android.material.button.MaterialButton android:id="@+id/areaApply"
        style="@style/MapFlowButton" android:layout_width="0dp" android:layout_weight="1"
        android:layout_marginStart="12dp" android:text="Apply" />
</LinearLayout>
