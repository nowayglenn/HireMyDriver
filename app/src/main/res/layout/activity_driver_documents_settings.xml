<?xml version='1.0' encoding='utf-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F8F9FB">
    <LinearLayout android:id="@+id/settingsHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="@dimen/screen_header_min_height" android:orientation="horizontal" android:gravity="center_vertical" android:background="#061B41" android:paddingStart="12dp" android:paddingEnd="24dp" android:tag="screen_header" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageButton android:id="@+id/btnSettingsBack" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:src="@drawable/ic_arrow_back" app:tint="#FFFFFF" android:contentDescription="Back" />
        <TextView android:id="@+id/settingsTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingVertical="12dp" android:layout_marginStart="8dp" android:text="Documents" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="@dimen/screen_header_title_size" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:id="@+id/settingsScroll" android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true" app:layout_constraintTop_toBottomOf="@id/settingsHeader" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="View your submitted driver documents." android:textColor="#687386" android:textSize="14sp" android:lineSpacingExtra="3dp" android:layout_marginBottom="12dp" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="16dp" app:cardElevation="1dp" app:strokeColor="#E3E6EA" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Driver's license" android:textColor="#061B41" android:textSize="18sp" android:lineSpacingExtra="3dp" android:layout_marginBottom="12dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Front and back of your submitted license." android:textColor="#687386" android:textSize="13sp" android:lineSpacingExtra="3dp" android:layout_marginBottom="12dp" />
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/settingsLicenseNumberLayout" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="License number" app:boxBackgroundColor="#F8F9FB" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" app:boxStrokeColor="#8E99A9">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/settingsLicenseNumber" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:textColor="#273142" android:textSize="14sp" android:padding="14dp" android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/settingsLicenseExpiryLayout" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Expiration date" app:boxBackgroundColor="#F8F9FB" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" app:boxStrokeColor="#8E99A9">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/settingsLicenseExpiry" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:textColor="#273142" android:textSize="14sp" android:padding="14dp" android:focusable="false" android:clickable="false" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Front of license" android:textColor="#061B41" android:textStyle="bold" android:textSize="14sp" />
                    <ImageView android:id="@+id/settingsLicenseFrontPreview" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="200dp" android:adjustViewBounds="true" android:layout_marginTop="10dp" android:background="@drawable/bg_upload_photo" android:padding="4dp" android:scaleType="fitCenter" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:contentDescription="Front of license preview" />
                    <TextView android:id="@+id/settingsLicenseFrontStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Not added" android:textColor="#687386" android:textSize="12sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Back of license" android:textColor="#061B41" android:textStyle="bold" android:textSize="14sp" />
                    <ImageView android:id="@+id/settingsLicenseBackPreview" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="200dp" android:adjustViewBounds="true" android:layout_marginTop="10dp" android:background="@drawable/bg_upload_photo" android:padding="4dp" android:scaleType="fitCenter" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:contentDescription="Back of license preview" />
                    <TextView android:id="@+id/settingsLicenseBackStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Not added" android:textColor="#687386" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="16dp" app:cardElevation="1dp" app:strokeColor="#E3E6EA" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Police clearance" android:textColor="#061B41" android:textSize="18sp" android:lineSpacingExtra="3dp" android:layout_marginBottom="12dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your submitted police clearance." android:textColor="#687386" android:textSize="13sp" android:lineSpacingExtra="3dp" android:layout_marginBottom="12dp" />
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/settingsClearanceIssueLayout" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Date of issue" app:boxBackgroundColor="#F8F9FB" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" app:boxStrokeColor="#8E99A9">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/settingsClearanceIssue" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:textColor="#273142" android:textSize="14sp" android:padding="14dp" android:focusable="false" android:clickable="false" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/settingsClearanceExpiryLayout" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Validity date" app:boxBackgroundColor="#F8F9FB" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" app:boxStrokeColor="#8E99A9">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/settingsClearanceExpiry" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:textColor="#273142" android:textSize="14sp" android:padding="14dp" android:focusable="false" android:clickable="false" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Police clearance" android:textColor="#061B41" android:textStyle="bold" android:textSize="14sp" />
                    <ImageView android:id="@+id/settingsPolicePreview" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="200dp" android:adjustViewBounds="true" android:layout_marginTop="10dp" android:background="@drawable/bg_upload_photo" android:padding="4dp" android:scaleType="fitCenter" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:contentDescription="Police clearance preview" />
                    <TextView android:id="@+id/settingsPoliceStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Not added" android:textColor="#687386" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
