<?xml version='1.0' encoding='utf-8'?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" app:cardCornerRadius="16dp" app:cardElevation="3dp" app:cardUseCompatPadding="true" android:id="@+id/bookingCard">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
        <com.google.android.material.imageview.ShapeableImageView android:layout_width="56dp" android:layout_height="56dp" android:scaleType="centerCrop" android:src="@drawable/laira" app:shapeAppearanceOverlay="@style/CircleImage" app:strokeColor="#EEF0F3" app:strokeWidth="1dp" android:id="@+id/bookingCardImage" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rafael Reyes" android:textColor="#061B41" android:textSize="16sp" android:textStyle="bold" android:id="@+id/bookingCardName" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="May 10, 2025 • 09:00 AM" android:textColor="#667085" android:textSize="13sp" android:id="@+id/bookingCardSchedule" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Cebu City → Talisay" android:textColor="#344054" android:textSize="13sp" android:id="@+id/bookingCardRoute" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="By the Hour (4 hours)" android:textColor="#667085" android:textSize="13sp" android:id="@+id/bookingCardPackage" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_info_light_blue" android:text="Completed" android:textColor="#1463D9" android:textSize="11sp" android:textStyle="bold" android:id="@+id/bookingCardStatus" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="3dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="★★★★★" android:textColor="#FF7900" android:textSize="14sp" android:id="@+id/bookingCardRating" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#9CA3AF" android:textSize="26sp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>

                
                