<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- HEADER -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#061B41"
        app:layout_constraintTop_toTopOf="parent"
        android:tag="screen_header"
        android:minHeight="@dimen/screen_header_min_height" >

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_target_size"
            android:layout_height="@dimen/touch_target_size"
            android:layout_marginStart="@dimen/screen_header_icon_margin"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@android:color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Filter Drivers"
            android:textColor="@android:color/white"
            android:textSize="@dimen/screen_header_title_size"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="@dimen/screen_header_title_gap"
            android:tag="screen_header_title"
            android:layout_marginTop="@dimen/screen_header_title_gap"
            android:layout_marginBottom="@dimen/screen_header_title_gap"
            android:layout_marginEnd="@dimen/screen_header_text_inset"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="start|center_vertical" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="always"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/bottomArea">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- EXPERIENCE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Experience"
                android:textColor="#1F2937"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipExpAll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_filter_chip_active"
                    android:gravity="center"
                    android:text="All"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="@dimen/action_button_min_height" />

                <TextView
                    android:id="@+id/chipExp1to3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_filter_chip"
                    android:gravity="center"
                    android:text="1-3 years"
                    android:textColor="#4B5563"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="@dimen/action_button_min_height" />

                <TextView
                    android:id="@+id/chipExp3to5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_filter_chip"
                    android:gravity="center"
                    android:text="3-5 years"
                    android:textColor="#4B5563"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="@dimen/action_button_min_height" />

                <TextView
                    android:id="@+id/chipExp5plus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_filter_chip"
                    android:gravity="center"
                    android:text="5+ years"
                    android:textColor="#4B5563"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="@dimen/action_button_min_height" />
            </LinearLayout>

            <!-- VEHICLE TYPE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Vehicle Type"
                android:textColor="#1F2937"
                android:textSize="16sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:scrollbars="none"
                android:requiresFadingEdge="horizontal"
                android:fadingEdgeLength="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:clipToPadding="false">

                    <LinearLayout
                        android:id="@+id/btnVehicleAll"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">
                        <ImageView
                            android:id="@+id/imgVehicleAll"
                            android:layout_width="56dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_filter_chip_active"
                            android:padding="10dp"
                            android:src="@drawable/ic_car_all"
                            app:tint="#FFFFFF" />
                        <TextView
                            android:id="@+id/txtVehicleAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="All"
                            android:textColor="#FF7900"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnVehicleSedan"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">
                        <ImageView
                            android:id="@+id/imgVehicleSedan"
                            android:layout_width="56dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_filter_chip"
                            android:padding="10dp"
                            android:src="@drawable/ic_vehicle"
                            app:tint="#6B7280" />
                        <TextView
                            android:id="@+id/txtVehicleSedan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Sedan"
                            android:textColor="#4B5563"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnVehicleSUV"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">
                        <ImageView
                            android:id="@+id/imgVehicleSUV"
                            android:layout_width="56dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_filter_chip"
                            android:padding="10dp"
                            android:src="@drawable/ic_vehicle"
                            app:tint="#6B7280" />
                        <TextView
                            android:id="@+id/txtVehicleSUV"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="SUV"
                            android:textColor="#4B5563"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnVehicleVan"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">
                        <ImageView
                            android:id="@+id/imgVehicleVan"
                            android:layout_width="56dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_filter_chip"
                            android:padding="10dp"
                            android:src="@drawable/ic_vehicle"
                            app:tint="#6B7280" />
                        <TextView
                            android:id="@+id/txtVehicleVan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Van"
                            android:textColor="#4B5563"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnVehiclePickup"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">
                        <ImageView
                            android:id="@+id/imgVehiclePickup"
                            android:layout_width="56dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_filter_chip"
                            android:padding="10dp"
                            android:src="@drawable/ic_vehicle"
                            app:tint="#6B7280" />
                        <TextView
                            android:id="@+id/txtVehiclePickup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Pickup"
                            android:textColor="#4B5563"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- SERVICE AREA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Service Area"
                android:textColor="#1F2937"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/btnServiceArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_dropdown"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="56dp" >
                <TextView
                    android:id="@+id/txtServiceArea"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Select area"
                    android:textColor="#6B7280"
                    android:textSize="15sp" />
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_down"
                    app:tint="#6B7280" />
            </LinearLayout>

            <!-- AVAILABILITY -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Availability"
                android:textColor="#1F2937"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/btnAvailability"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_dropdown"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="56dp" >
                <TextView
                    android:id="@+id/txtAvailability"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Select available day"
                    android:textColor="#6B7280"
                    android:textSize="15sp" />
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_down"
                    app:tint="#6B7280" />
            </LinearLayout>

            <!-- RATING -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Rating"
                android:textColor="#1F2937"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipRatingAll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_filter_chip_active"
                    android:gravity="center"
                    android:text="All"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="@dimen/action_button_min_height" />

                <TextView
                    android:id="@+id/chipRating4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_filter_chip"
                    android:gravity="center"
                    android:text="★ 4+"
                    android:textColor="#4B5563"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="@dimen/action_button_min_height" />

                <TextView
                    android:id="@+id/chipRating3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_filter_chip"
                    android:gravity="center"
                    android:text="★ 3+"
                    android:textColor="#4B5563"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="@dimen/action_button_min_height" />

                <TextView
                    android:id="@+id/chipRating2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_filter_chip"
                    android:gravity="center"
                    android:text="★ 2+"
                    android:textColor="#4B5563"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="@dimen/action_button_min_height" />

                <TextView
                    android:id="@+id/chipRating1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_filter_chip"
                    android:gravity="center"
                    android:text="★ 1+"
                    android:textColor="#4B5563"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="@dimen/action_button_min_height" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM AREA -->
    <LinearLayout
        android:id="@+id/bottomArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Apply Filters"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/action_button_text_size"
            android:textStyle="bold"
            app:backgroundTint="#FF7900"
            app:cornerRadius="12dp"
            android:minHeight="@dimen/action_button_min_height"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="false" />

        <TextView
            android:id="@+id/btnClearAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:text="Clear All"
            android:textColor="#FF7900"
            android:textSize="@dimen/action_button_text_size"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="@dimen/action_button_min_height"
            android:minWidth="@dimen/touch_target_size"
            android:gravity="center" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>