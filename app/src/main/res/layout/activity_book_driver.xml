<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- HEADER -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#061B41"
        app:layout_constraintTop_toTopOf="parent"
        android:tag="screen_header"
        android:minHeight="@dimen/screen_header_min_height" >

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_target_size"
            android:layout_height="@dimen/touch_target_size"
            android:layout_marginStart="@dimen/screen_header_icon_margin"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@android:color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_header_title_gap"
            android:text="@string/book_driver_title"
            android:textColor="@android:color/white"
            android:textSize="@dimen/screen_header_title_size"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:tag="screen_header_title"
            android:layout_marginTop="@dimen/screen_header_title_gap"
            android:layout_marginBottom="@dimen/screen_header_title_gap"
            android:layout_marginEnd="@dimen/screen_header_text_inset"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="start|center_vertical" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/btnConfirmBooking"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Driver Summary -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="16dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgDriverSmall"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/no_profile"
                    app:shapeAppearanceOverlay="@style/CircleImage"
                    app:strokeColor="#EEF0F3"
                    app:strokeWidth="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtDriverName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mark Laurence Polinar"
                        android:textColor="#061B41"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="★ 4.9"
                        android:textColor="#FF7900"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtPriceHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="₱650 / hour"
                        android:textColor="#061B41"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/booking_details_label"
                android:textColor="#061B41"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Date -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_date"
                android:textColor="#667085"
                android:textSize="13sp" />
            <LinearLayout
                android:id="@+id/containerDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:minHeight="56dp" >
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_calendar"
                    app:tint="#061B41" />
                <TextView
                    android:id="@+id/txtDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="May 25, 2025"
                    android:textColor="#061B41"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Start Time -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_start_time"
                android:textColor="#667085"
                android:textSize="13sp" />
            <LinearLayout
                android:id="@+id/containerTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:minHeight="56dp" >
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_schedule"
                    app:tint="#061B41" />
                <TextView
                    android:id="@+id/txtTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="08:00 AM"
                    android:textColor="#061B41"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Duration -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_duration"
                android:textColor="#667085"
                android:textSize="13sp" />
            <LinearLayout
                android:id="@+id/containerDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:minHeight="56dp" >
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_schedule"
                    app:tint="#061B41" />
                <TextView
                    android:id="@+id/txtDuration"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="4 hours"
                    android:textColor="#061B41"
                    android:textSize="15sp" />
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_down"
                    app:tint="#667085" />
            </LinearLayout>

            <!-- Pickup -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_pickup"
                android:textColor="#667085"
                android:textSize="13sp" />
            <LinearLayout
                android:id="@+id/containerPickup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_trip_card"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:minHeight="56dp" >
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_location"
                    app:tint="#061B41" />
                <EditText
                    android:id="@+id/edtPickup"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:layout_marginStart="12dp"
                    android:background="@android:color/transparent"
                    android:hint="e.g. Cebu City"
                    android:textColor="#061B41"
                    android:textSize="15sp"
                    android:inputType="text" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPinPickup" style="@style/TripButton.Outline"
                android:layout_marginTop="8dp" android:text="Choose pickup on map" />

            <!-- Destination -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_destination"
                android:textColor="#667085"
                android:textSize="13sp" />
            <LinearLayout
                android:id="@+id/containerDestination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_trip_card"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:minHeight="56dp" >
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_location"
                    app:tint="#061B41" />
                <EditText
                    android:id="@+id/edtDestination"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:layout_marginStart="12dp"
                    android:background="@android:color/transparent"
                    android:hint="e.g. Mandaue City"
                    android:textColor="#061B41"
                    android:textSize="15sp"
                    android:inputType="text" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPinDestination" style="@style/TripButton.Outline"
                android:layout_marginTop="12dp" android:text="Choose destination on map" />
            <TextView android:id="@+id/txtExtraDestinations" style="@style/TripText"
                android:layout_marginTop="12dp" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddBookingDestination" style="@style/TripButton.Outline"
                android:layout_marginTop="8dp" android:text="Add another destination" />

            <!-- Vehicle Type -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_vehicle_type"
                android:textColor="#667085"
                android:textSize="13sp" />
            <LinearLayout
                android:id="@+id/containerVehicle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:minHeight="56dp" >
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_vehicle"
                    app:tint="#061B41" />
                <TextView
                    android:id="@+id/txtVehicle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="SUV"
                    android:textColor="#061B41"
                    android:textSize="15sp" />
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_down"
                    app:tint="#667085" />
            </LinearLayout>

            <!-- Notes -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_notes_optional"
                android:textColor="#667085"
                android:textSize="13sp" />
            <EditText
                android:id="@+id/edtNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:gravity="top"
                android:hint="@string/hint_notes"
                android:minHeight="100dp"
                android:padding="16dp"
                android:textColor="#061B41"
                android:textSize="15sp"
                android:inputType="textMultiLine" />

            <!-- Fee Summary -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#FFF4E5"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/lblFee"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/estimated_fee"
                        android:textColor="#061B41"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <TextView
                        android:id="@+id/txtTotalAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="₱2,600.00"
                        android:textColor="#061B41"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/lblFee" />
                    <TextView
                        android:id="@+id/txtCalculation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₱650 x 4 hours"
                        android:textColor="#667085"
                        android:textSize="13sp"
                        app:layout_constraintBottom_toBottomOf="@id/txtTotalAmount"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Confirm Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmBooking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:text="@string/btn_confirm_booking"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/action_button_text_size"
        android:textStyle="bold"
        app:backgroundTint="#FF7900"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:minHeight="@dimen/action_button_min_height"
        android:gravity="center"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="false" />

</androidx.constraintlayout.widget.ConstraintLayout>
