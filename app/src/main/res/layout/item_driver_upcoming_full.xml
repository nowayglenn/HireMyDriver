<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Calendar Badge -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="72dp"
                            android:layout_height="86dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeColor="#E8EAF0"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical">

                                <TextViewandroid:id="@+id/bookingCardMonth" 
                                    android:layout_width="match_parent"
                                    android:layout_height="26dp"
                                    android:background="#FF7900"
                                    android:gravity="center"
                                    android:text="MAY"
                                    android:textColor="@android:color/white"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@android:color/white"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <TextViewandroid:id="@+id/bookingCardDay" 
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="20"
                                        android:textColor="#061B41"
                                        android:textSize="20sp"
                                        android:textStyle="bold"
                                        android:includeFontPadding="false" />

                                    <TextViewandroid:id="@+id/bookingCardTime" 
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="10:00 AM"
                                        android:textColor="#FF7900"
                                        android:textSize="10sp"
                                        android:textStyle="bold"
                                        android:includeFontPadding="false" />
                                </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<com.google.android.material.imageview.ShapeableImageView android:id="@+id/bookingCardImage" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="10dp" android:src="@drawable/no_profile" android:scaleType="centerCrop" app:shapeAppearanceOverlay="@style/CircleImage" android:contentDescription="Customer profile"/>
<TextViewandroid:id="@+id/bookingCardName" 
                                android:layout_width="0dp" android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="John Doe"
                                android:textColor="#061B41"
                                android:textSize="17sp"
                                android:textStyle="bold" />
</LinearLayout>

                            <TextViewandroid:id="@+id/bookingCardRoute" 
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Cebu City → Lapu-Lapu City"
                                android:textColor="#667085"
                                android:textSize="13sp" />

                            <TextViewandroid:id="@+id/bookingCardPackage" 
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="By the Hour (4 hours) • ₱2,000"
                                android:textColor="#344054"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextViewandroid:id="@+id/bookingCardStatus" 
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_status_accepted_green"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="3dp"
                                android:text="Accepted"
                                android:textColor="#00B85A"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal"
                        android:baselineAligned="false" >

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStartTrip1"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="Start Trip"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/action_button_text_size"
                            android:textStyle="bold"
                            app:backgroundTint="#00B85A"
                            app:cornerRadius="8dp"
                            android:minHeight="@dimen/action_button_min_height"
                            android:gravity="center"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:singleLine="false" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMessage1"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="Message"
                            android:textAllCaps="false"
                            android:textColor="#061B41"
                            android:textSize="@dimen/action_button_text_size"
                            android:textStyle="bold"
                            app:backgroundTint="#F2F4F7"
                            app:cornerRadius="8dp"
                            android:minHeight="@dimen/action_button_min_height"
                            android:gravity="center"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:singleLine="false" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>
