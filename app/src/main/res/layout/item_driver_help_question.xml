<TextView android:id="@+id/helpQuestionIndicator" android:layout_width="24dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:gravity="center" android:text="+" android:textColor="#FF8A00" android:textSize="24sp" android:importantForAccessibility="no"/>
</LinearLayout>
