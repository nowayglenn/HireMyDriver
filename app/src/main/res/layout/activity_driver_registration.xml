<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- TOP HEADER -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#001B43"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:tag="screen_header"
        android:minHeight="@dimen/screen_header_min_height" >

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_target_size"
            android:layout_height="@dimen/touch_target_size"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FFFFFF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="@dimen/screen_header_icon_margin" />

        <TextView
            android:id="@+id/txtHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Driver Registration"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/screen_header_title_size"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:tag="screen_header_title"
            android:layout_marginTop="@dimen/screen_header_title_gap"
            android:layout_marginBottom="@dimen/screen_header_title_gap"
            android:layout_marginStart="@dimen/screen_header_title_gap"
            android:layout_marginEnd="@dimen/screen_header_text_inset"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="start|center_vertical" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- MAIN CONTENT -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="24dp">

            <!-- STEP PROCESS -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/stepContainer"
                android:layout_width="match_parent"
                android:layout_height="82dp">

                <TextView
                    android:id="@+id/step1"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_step_active"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/step2"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_step_inactive"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/step1"
                    app:layout_constraintEnd_toStartOf="@id/step3"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintHorizontal_chainStyle="spread" />

                <TextView
                    android:id="@+id/step3"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_step_inactive"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/step2"
                    app:layout_constraintEnd_toStartOf="@id/step4"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/step4"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_step_inactive"
                    android:gravity="center"
                    android:text="4"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:background="#D9DEE7"
                    app:layout_constraintStart_toEndOf="@id/step1"
                    app:layout_constraintEnd_toStartOf="@id/step2"
                    app:layout_constraintTop_toTopOf="@id/step1"
                    app:layout_constraintBottom_toBottomOf="@id/step1" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:background="#D9DEE7"
                    app:layout_constraintStart_toEndOf="@id/step2"
                    app:layout_constraintEnd_toStartOf="@id/step3"
                    app:layout_constraintTop_toTopOf="@id/step2"
                    app:layout_constraintBottom_toBottomOf="@id/step2" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:background="#D9DEE7"
                    app:layout_constraintStart_toEndOf="@id/step3"
                    app:layout_constraintEnd_toStartOf="@id/step4"
                    app:layout_constraintTop_toTopOf="@id/step3"
                    app:layout_constraintBottom_toBottomOf="@id/step3" />

                <TextView
                    android:id="@+id/labelStep1"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="Account"
                    android:textColor="#FF8A00"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@id/step1"
                    app:layout_constraintEnd_toEndOf="@id/step1"
                    app:layout_constraintTop_toBottomOf="@id/step1" />

                <TextView
                    android:id="@+id/labelStep2"
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Personal Info"
                    android:textColor="#687386"
                    android:textSize="9sp"
                    app:layout_constraintStart_toStartOf="@id/step2"
                    app:layout_constraintEnd_toEndOf="@id/step2"
                    app:layout_constraintTop_toBottomOf="@id/step2" />

                <TextView
                    android:id="@+id/labelStep3"
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="License Info"
                    android:textColor="#687386"
                    android:textSize="9sp"
                    app:layout_constraintStart_toStartOf="@id/step3"
                    app:layout_constraintEnd_toEndOf="@id/step3"
                    app:layout_constraintTop_toBottomOf="@id/step3" />

                <TextView
                    android:id="@+id/labelStep4"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="Review"
                    android:textColor="#687386"
                    android:textSize="9sp"
                    app:layout_constraintStart_toStartOf="@id/step4"
                    app:layout_constraintEnd_toEndOf="@id/step4"
                    app:layout_constraintTop_toBottomOf="@id/step4" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Create Your Account"
                android:textColor="#273142"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Fill in your account details to get started."
                android:textColor="#687386"
                android:textSize="13sp" />

            <!-- FORM (7dp Corners - Original Style) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutFullName"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="Full Name"
                app:boxBackgroundColor="#F8F9FB"
                app:boxCornerRadiusBottomEnd="7dp"
                app:boxCornerRadiusBottomStart="7dp"
                app:boxCornerRadiusTopEnd="7dp"
                app:boxCornerRadiusTopStart="7dp"
                app:boxStrokeColor="#8E99A9"
                app:hintTextColor="#687386"
                app:startIconDrawable="@drawable/ic_profile"
                app:startIconTint="#687386">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtFullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:inputType="textPersonName"
                    android:textColor="#273142"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutEmail"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:hint="Email Address"
                app:boxBackgroundColor="#F8F9FB"
                app:boxCornerRadiusBottomEnd="7dp"
                app:boxCornerRadiusBottomStart="7dp"
                app:boxCornerRadiusTopEnd="7dp"
                app:boxCornerRadiusTopStart="7dp"
                app:boxStrokeColor="#8E99A9"
                app:hintTextColor="#687386"
                app:startIconDrawable="@drawable/ic_email"
                app:startIconTint="#687386">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:inputType="textEmailAddress"
                    android:textColor="#273142"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutMobile"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:hint="Mobile Number"
                app:boxBackgroundColor="#F8F9FB"
                app:boxCornerRadiusBottomEnd="7dp"
                app:boxCornerRadiusBottomStart="7dp"
                app:boxCornerRadiusTopEnd="7dp"
                app:boxCornerRadiusTopStart="7dp"
                app:boxStrokeColor="#8E99A9"
                app:hintTextColor="#687386"
                app:startIconDrawable="@drawable/ic_phone"
                app:startIconTint="#687386">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtMobile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:inputType="phone"
                    android:textColor="#273142"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutPassword"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:hint="Password"
                app:boxBackgroundColor="#F8F9FB"
                app:boxCornerRadiusBottomEnd="7dp"
                app:boxCornerRadiusBottomStart="7dp"
                app:boxCornerRadiusTopEnd="7dp"
                app:boxCornerRadiusTopStart="7dp"
                app:boxStrokeColor="#8E99A9"
                app:endIconMode="password_toggle"
                app:endIconTint="#687386"
                app:hintTextColor="#687386"
                app:startIconDrawable="@drawable/ic_lock"
                app:startIconTint="#687386">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:inputType="textPassword"
                    android:textColor="#273142"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutConfirmPassword"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:hint="Confirm Password"
                app:boxBackgroundColor="#F8F9FB"
                app:boxCornerRadiusBottomEnd="7dp"
                app:boxCornerRadiusBottomStart="7dp"
                app:boxCornerRadiusTopEnd="7dp"
                app:boxCornerRadiusTopStart="7dp"
                app:boxStrokeColor="#8E99A9"
                app:endIconMode="password_toggle"
                app:endIconTint="#687386"
                app:hintTextColor="#687386"
                app:startIconDrawable="@drawable/ic_lock"
                app:startIconTint="#687386">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:inputType="textPassword"
                    android:textColor="#273142"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- SECURITY BOX -->
            <LinearLayout
                android:id="@+id/securityBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_security_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:minHeight="52dp" >
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Security"
                    android:src="@drawable/ic_lock"
                    app:tint="#355D91" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Your information is secure with us.\nWe\'ll never share your data with anyone."
                    android:textColor="#53708F"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Terms & Conditions Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/chkTerms"
                    android:contentDescription="Agree to the Terms and Conditions"
                    android:layout_width="@dimen/touch_target_size"
                    android:layout_height="@dimen/touch_target_size"
                    android:button="@drawable/selector_terms_checkbox"
                    android:buttonTint="@null"
                    app:buttonTint="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="I agree to the "
                    android:textColor="#687386"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtTermsLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Terms &amp; Conditions"
                    android:textColor="#FF8A00"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtTermsError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Please agree to the Terms &amp; Conditions"
                android:textColor="#C62828"
                android:textSize="12sp"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Next"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/action_button_text_size"
                android:textStyle="bold"
                app:backgroundTint="#FF8A00"
                app:cornerRadius="7dp"
                android:minHeight="@dimen/action_button_min_height"
                android:gravity="center"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Already have an account? "
                    android:textColor="#687386"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/txtLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Login"
                    android:textColor="#FF8A00"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
