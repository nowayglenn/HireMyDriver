<?xml version='1.0' encoding='utf-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F8F9FB">
    <LinearLayout android:id="@+id/settingsHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="@dimen/screen_header_min_height" android:orientation="horizontal" android:gravity="center_vertical" android:background="#061B41" android:paddingStart="12dp" android:paddingEnd="24dp" android:tag="screen_header" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageButton android:id="@+id/btnSettingsBack" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:src="@drawable/ic_arrow_back" app:tint="#FFFFFF" android:contentDescription="Back" />
        <TextView android:id="@+id/settingsTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingVertical="12dp" android:layout_marginStart="8dp" android:text="Personal Information" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="@dimen/screen_header_title_size" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:id="@+id/settingsScroll" android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true" app:layout_constraintTop_toBottomOf="@id/settingsHeader" app:layout_constraintBottom_toTopOf="@id/settingsFooter" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Manage your personal details." android:textColor="#687386" android:textSize="14sp" android:lineSpacingExtra="3dp" android:layout_marginBottom="12dp" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="16dp" app:cardElevation="1dp" app:strokeColor="#E3E6EA" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Contact details" android:textColor="#061B41" android:textSize="18sp" android:lineSpacingExtra="3dp" android:layout_marginBottom="12dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Keep your name and contact information up to date." android:textColor="#687386" android:textSize="13sp" android:lineSpacingExtra="3dp" android:layout_marginBottom="12dp" />
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/settingsNameLayout" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Full name" app:boxBackgroundColor="#F8F9FB" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" app:boxStrokeColor="#8E99A9">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/settingsName" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:textColor="#273142" android:textSize="14sp" android:padding="14dp" android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/settingsEmailLayout" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Email address" app:boxBackgroundColor="#F8F9FB" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" app:boxStrokeColor="#8E99A9">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/settingsEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:textColor="#273142" android:textSize="14sp" android:padding="14dp" android:inputType="textEmailAddress" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/settingsMobileLayout" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Mobile number (optional)" app:boxBackgroundColor="#F8F9FB" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" app:boxStrokeColor="#8E99A9">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/settingsMobile" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:textColor="#273142" android:textSize="14sp" android:padding="14dp" android:inputType="phone" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="16dp" app:cardElevation="1dp" app:strokeColor="#E3E6EA" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="About you" android:textColor="#061B41" android:textSize="18sp" android:lineSpacingExtra="3dp" android:layout_marginBottom="12dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Add details to your driver profile." android:textColor="#687386" android:textSize="13sp" android:lineSpacingExtra="3dp" android:layout_marginBottom="12dp" />
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/settingsBirthDateLayout" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Date of birth (optional)" app:boxBackgroundColor="#F8F9FB" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" app:boxStrokeColor="#8E99A9">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/settingsBirthDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:textColor="#273142" android:textSize="14sp" android:padding="14dp" android:focusable="false" android:clickable="true" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/settingsAddressLayout" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Address (optional)" app:boxBackgroundColor="#F8F9FB" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" app:boxStrokeColor="#8E99A9">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/settingsAddress" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:textColor="#273142" android:textSize="14sp" android:padding="14dp" android:inputType="textPostalAddress" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/settingsBioLayout" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Short bio (optional)" app:boxBackgroundColor="#F8F9FB" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" app:boxStrokeColor="#8E99A9">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/settingsBio" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:textColor="#273142" android:textSize="14sp" android:padding="14dp" android:inputType="textMultiLine" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:id="@+id/settingsFooter" android:layout_width="0dp" android:layout_height="wrap_content" android:padding="20dp" android:orientation="vertical" android:background="#FFFFFF" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSettingsSave" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/action_button_min_height" android:text="Save Changes" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="@dimen/action_button_text_size" android:textStyle="bold" android:insetTop="0dp" android:insetBottom="0dp" android:paddingVertical="12dp" app:backgroundTint="#FF8A00" app:cornerRadius="12dp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>