<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true">
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="@drawable/bg_booking_card">

    <!-- Orange Exclamation Icon Circle -->
    <FrameLayout
        android:visibility="gone"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_important_box">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_help"
            app:tint="#FF7900" />

    </FrameLayout>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:text="Decline Booking?"
        android:textColor="#061B41"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="Are you sure you want to decline this booking request?"
        android:textColor="#667085"
        android:textSize="14sp" />

    <!-- Bottom Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:baselineAligned="false" >

        <!-- Cancel Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelDecline"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#061B41"
            android:textSize="@dimen/action_button_text_size"
            android:textStyle="bold"
            app:strokeColor="#D1D5DB"
            app:strokeWidth="1dp"
            app:cornerRadius="8dp"
            android:minHeight="@dimen/action_button_min_height"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="false" />

        <!-- Confirm Decline Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmDecline"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Decline"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/action_button_text_size"
            android:textStyle="bold"
            app:backgroundTint="#E53935"
            app:cornerRadius="8dp"
            android:minHeight="@dimen/action_button_min_height"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="false" />

    </LinearLayout>

</LinearLayout>
</ScrollView>
