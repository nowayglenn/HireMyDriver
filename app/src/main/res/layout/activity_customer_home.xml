<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:focusableInTouchMode="true">

    <!-- ========================= -->
    <!-- TOP HEADER -->
    <!-- ========================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="250dp"
        android:background="@drawable/img_home_car_bg"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:tag="screen_header" >

        <!-- Hello -->
        <TextView
            android:id="@+id/txtHello"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            tools:text="Hello, Glenndhel!"
            android:layout_marginEnd="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnNotification"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Notification -->
        <ImageButton
            android:id="@+id/btnNotification"
            android:layout_width="@dimen/touch_target_size"
            android:layout_height="@dimen/touch_target_size"
            android:layout_marginTop="28dp"
            android:background="@android:color/transparent"
            android:contentDescription="Notifications"
            android:src="@drawable/ic_notification"
            app:tint="#FFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:padding="12dp" />

        <TextView
            android:id="@+id/txtQuestion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"

            android:text="Where do you need\na driver today?"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="0.9"
            android:includeFontPadding="false"
            android:maxLines="3"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/imgDriverHome"
            app:layout_constraintTop_toBottomOf="@id/txtHello" />

        <!-- Driver Image on Right -->
        <ImageView
            android:id="@+id/imgDriverHome"
            android:layout_width="170dp"
            android:layout_height="250dp"
            android:src="@drawable/driver"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="-5dp"
            android:layout_marginBottom="-20dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ========================= -->
    <!-- MAIN CONTENT CONTAINER (WHITE OVERLAP) -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/mainContentArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="-30dp"
        android:background="@drawable/bg_home_content"
        android:orientation="vertical"
        android:elevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ========================= -->
        <!-- SEARCH BOX -->
        <!-- ========================= -->

        <LinearLayout
            android:id="@+id/searchContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="4dp"
            android:clipToOutline="true"
            android:elevation="4dp"
            android:outlineProvider="background"
            android:minHeight="56dp" >

            <!-- Search icon -->
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Search"
                android:src="@drawable/ic_search"
                app:tint="#6B7280" />

            <EditText
                android:id="@+id/edtSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/search_hint"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:maxLines="1"
                android:textColor="#1F2937"
                android:textColorHint="#9CA3AF"
                android:textSize="14sp"
                android:imeOptions="actionSearch"
                android:inputType="text" />

            <!-- Clear / X Icon (Left side of Filter Button) -->
            <ImageButton
                android:id="@+id/btnClearSearch"
                android:layout_width="@dimen/touch_target_size"
                android:layout_height="@dimen/touch_target_size"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Clear search"
                android:padding="12dp"
                android:src="@drawable/ic_delete"
                app:tint="#9CA3AF"
                android:visibility="gone" />

            <!-- Filter -->
            <ImageButton
                android:id="@+id/btnFilter"
                android:layout_width="@dimen/touch_target_size"
                android:layout_height="@dimen/touch_target_size"
                android:background="@drawable/bg_home_filter"
                android:contentDescription="Filter"
                android:padding="12dp"
                android:src="@drawable/ic_filter"
                app:tint="#FFFFFF" />

        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/homeRefresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/homeScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none"
                android:overScrollMode="always"
                android:clipToPadding="false"
                android:paddingTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="20dp">

                    <!-- ========================= -->
                    <!-- SEARCH RESULTS SECTION -->
                    <!-- ========================= -->

                    <LinearLayout
                        android:id="@+id/searchResultsSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="16dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/txtSearchTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Search Results"
                                android:textColor="#273142"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtSearchResultCount"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="0 drivers found"
                                android:textColor="#FF7A00"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:layout_weight="1"
                                android:gravity="end|center_vertical" />

                        </LinearLayout>

                        <!-- Dynamic Search Results List Container -->
                        <LinearLayout
                            android:id="@+id/searchListContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical" />

                        <!-- Empty Search Result -->
                        <LinearLayout
                            android:id="@+id/searchEmptyView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="32dp"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:src="@drawable/ic_search"
                                app:tint="#D1D5DB" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="No Drivers Found"
                                android:textColor="#273142"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtEmptyHint"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:text="Try searching for driver names like 'Mika' or locations like 'Cebu City'."
                                android:textColor="#68717E"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- ========================= -->
                    <!-- AI BANNER -->
                    <!-- ========================= -->

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardAiBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_marginEnd="18dp"
                        android:layout_marginTop="20dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#F3E5F5">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp">

                            <ImageView
                                android:id="@+id/imgSparkle"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_sparkle"
                                app:tint="#4527A0"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent" />

                            <TextView
                                android:id="@+id/txtAiTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:text="@string/find_best_driver"
                                android:textColor="#061B41"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                app:layout_constraintStart_toEndOf="@id/imgSparkle"
                                app:layout_constraintEnd_toStartOf="@id/icArrowAi"
                                android:layout_marginEnd="8dp"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/ai_recommend_desc"
                                android:textColor="#667085"
                                android:textSize="13sp"
                                android:layout_marginTop="2dp"
                                app:layout_constraintStart_toStartOf="@id/txtAiTitle"
                                app:layout_constraintTop_toBottomOf="@id/txtAiTitle"
                                app:layout_constraintEnd_toStartOf="@id/icArrowAi" />

                            <ImageView
                                android:id="@+id/icArrowAi"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_arrow_back"
                                android:rotation="180"
                                app:tint="#061B41"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent" />

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>


                    <!-- ========================= -->
                    <!-- AI RECOMMENDED SECTION -->
                    <!-- ========================= -->

                    <LinearLayout
                        android:id="@+id/aiRecommendedSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:minHeight="40dp" >

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/ai_recommended"
                                android:textColor="#273142"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtSeeAllAi"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/see_all"
                                android:textColor="#FF7A00"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:padding="4dp"
                                android:layout_weight="1"
                                android:gravity="end|center_vertical" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtNearbyStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:paddingVertical="8dp"
                            android:gravity="center_vertical"
                            android:text="@string/recommendation_locating"
                            android:textColor="#667085"
                            android:textSize="12sp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground" />

                        <include
                            android:id="@+id/aiRecommendedDriver"
                            layout="@layout/item_ai_driver"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>


                    <!-- ========================= -->
                    <!-- POPULAR DRIVERS SECTION -->
                    <!-- ========================= -->

                    <LinearLayout
                        android:id="@+id/driverSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="20dp">

                        <!-- Section title -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:minHeight="40dp" >

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/popular_drivers"
                                android:textColor="#273142"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtSeeAll"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/see_all"
                                android:textColor="#FF7A00"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:padding="4dp"
                                android:layout_weight="1"
                                android:gravity="end|center_vertical" />

                        </LinearLayout>

                        <!-- DRIVER 1 -->
                        <include
                            layout="@layout/item_driver"
                            android:id="@+id/driver1" />

                        <!-- DRIVER 2 -->
                        <include
                            layout="@layout/item_driver"
                            android:id="@+id/driver2" />

                        <!-- DRIVER 3 -->
                        <include
                            layout="@layout/item_driver"
                            android:id="@+id/driver3" />

                        <!-- DRIVER 4 -->
                        <include
                            layout="@layout/item_driver"
                            android:id="@+id/driver4" />

                        <!-- DRIVER 5 -->
                        <include
                            layout="@layout/item_driver"
                            android:id="@+id/driver5" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Fixed Gradient Over the top of scroll view -->
            <View
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_top_fade_gradient"
                android:layout_gravity="top" />

        </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>


    <!-- ========================= -->
    <!-- BOTTOM NAVIGATION -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:background="#FFFFFF"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- HOME (ACTIVE) -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconHome"
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_nav_active"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp"
                android:src="@drawable/icons_home"
                app:tint="#FF7A00" />

            <TextView android:gravity="center" android:maxLines="2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_home"
                android:textColor="#FF7A00"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- BOOKINGS -->
        <LinearLayout
            android:id="@+id/navBookings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconBookings"
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp"
                android:src="@drawable/icons_calendar"
                app:tint="#68717E" />

            <TextView android:gravity="center" android:maxLines="2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_bookings"
                android:textColor="#68717E"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- MESSAGES -->
        <LinearLayout
            android:id="@+id/navMessages"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconMessages"
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp"
                android:src="@drawable/icons_message"
                app:tint="#68717E" />

            <TextView android:gravity="center" android:maxLines="2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_messages"
                android:textColor="#68717E"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- PROFILE -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconProfile"
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp"
                android:src="@drawable/icons_profile"
                app:tint="#68717E" />

            <TextView android:gravity="center" android:maxLines="2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_profile"
                android:textColor="#68717E"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
