<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_booking_dialog"
    android:padding="24dp">
    <TextView
        android:id="@+id/bookingChoiceTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textStyle="normal"
        android:textSize="22sp"
        android:textColor="#061B41" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Tap an option to select"
        android:fontFamily="sans-serif"
        android:textStyle="normal"
        android:textSize="14sp"
        android:textColor="#667085" />
    <ListView
        android:id="@+id/bookingChoiceList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:choiceMode="singleChoice"
        android:divider="@android:color/transparent"
        android:dividerHeight="6dp"
        android:listSelector="@android:color/transparent"
        android:scrollbars="vertical" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/bookingChoiceCancel"
        style="@style/MapFlowButton.Outline"
        android:layout_marginTop="16dp"
        android:text="Cancel" />
</LinearLayout>
