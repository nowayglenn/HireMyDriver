<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/messageHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#061B41"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:tag="screen_header"
        android:minHeight="@dimen/screen_header_min_height" >

        <TextView
            android:id="@+id/txtMessageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_header_text_inset"
            android:text="Messages"
            android:textColor="@android:color/white"
            android:textSize="@dimen/screen_header_title_size"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:tag="screen_header_title"
            android:layout_marginTop="@dimen/screen_header_title_gap"
            android:layout_marginBottom="@dimen/screen_header_title_gap"
            android:layout_marginEnd="@dimen/screen_header_title_gap"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="start|center_vertical" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ===================================================== -->
    <!-- MAIN / UNREAD TABS -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/messageTabs"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/white"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/messageHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- VIEW ALL / MAIN -->
        <LinearLayout
            android:id="@+id/tabMain"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/txtMain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View All"
                android:textColor="#061B41"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/mainIndicator"
                android:layout_width="55dp"
                android:layout_height="3dp"
                android:layout_marginTop="8dp"
                android:background="#FF7900" />

        </LinearLayout>

        <!-- UNREAD -->
        <LinearLayout
            android:id="@+id/tabUnread"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/txtUnread"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unread"
                android:textColor="#667085"
                android:textSize="16sp" />

            <View
                android:id="@+id/unreadIndicator"
                android:layout_width="55dp"
                android:layout_height="3dp"
                android:layout_marginTop="8dp"
                android:background="@android:color/transparent" />

        </LinearLayout>

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- CHAT LIST -->
    <!-- ===================================================== -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/chatScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="always"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/messageTabs"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:id="@+id/chatListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>


    <!-- ===================================================== -->
    <!-- PLAIN BOTTOM NAVIGATION -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:background="#FFFFFF"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- HOME -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconHome"
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp"
                android:src="@drawable/icons_home"
                app:tint="#68717E" />

            <TextView android:gravity="center" android:maxLines="2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_home"
                android:textColor="#68717E"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- BOOKING -->
        <LinearLayout
            android:id="@+id/navBooking"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconBooking"
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp"
                android:src="@drawable/icons_calendar"
                app:tint="#68717E" />

            <TextView android:gravity="center" android:maxLines="2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_bookings"
                android:textColor="#68717E"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- MESSAGE (ACTIVE) -->
        <LinearLayout
            android:id="@+id/navMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconMessage"
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_nav_active"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp"
                android:src="@drawable/icons_message"
                app:tint="#FF7A00" />

            <TextView android:gravity="center" android:maxLines="2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_messages"
                android:textColor="#FF7A00"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- PROFILE -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconProfile"
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp"
                android:src="@drawable/icons_profile"
                app:tint="#68717E" />

            <TextView android:gravity="center" android:maxLines="2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_profile"
                android:textColor="#68717E"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>