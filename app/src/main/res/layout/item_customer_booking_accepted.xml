<?xml version='1.0' encoding='utf-8'?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/bookingCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="16dp" app:cardElevation="4dp" app:cardUseCompatPadding="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.imageview.ShapeableImageView android:layout_width="54dp" android:layout_height="54dp" android:contentDescription="Customer" android:id="@+id/bookingCardImage" android:src="@drawable/no_profile" android:scaleType="centerCrop" app:shapeAppearanceOverlay="@style/BookingPhotoShape" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mark Laurence Polinar" android:textColor="#061B41" android:textSize="15sp" android:textStyle="bold" android:id="@+id/bookingCardName" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="★ 4.9" android:textColor="#FF7A00" android:textSize="11sp" android:textStyle="bold" android:id="@+id/bookingCardRating" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="May 25, 2025 • 08:00 AM" android:textColor="#667085" android:textSize="11sp" android:id="@+id/bookingCardSchedule" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Cebu City → Mandaue City" android:textColor="#344054" android:textSize="11sp" android:id="@+id/bookingCardRoute" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="10 years experience • Sedan, SUV" android:textColor="#667085" android:textSize="11sp" android:id="@+id/bookingCardPackage" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_match_badge" android:paddingStart="8dp" android:paddingTop="5dp" android:paddingEnd="8dp" android:paddingBottom="5dp" android:text="@string/status_on_trip" android:textColor="#159447" android:textSize="9sp" android:textStyle="bold" android:id="@+id/bookingCardStatus" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
            <LinearLayout android:id="@+id/btnTrackTrip" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/bg_btn_track" android:gravity="center" android:orientation="horizontal" android:clickable="true" android:focusable="true" android:minHeight="44dp">
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_location" app:tint="#1463D9" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/btn_track_trip" android:textColor="#1463D9" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/btnEmergencyAccepted" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:background="@drawable/bg_btn_emergency_outline" android:gravity="center" android:orientation="horizontal" android:clickable="true" android:focusable="true" android:minHeight="44dp">
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_siren" app:tint="#F04438" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/btn_emergency" android:textColor="#F04438" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:background="#EEF0F3" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="₱2,600.00" android:textColor="#061B41" android:textSize="17sp" android:textStyle="bold" android:id="@+id/bookingCardFee" />
            <TextView android:id="@+id/bookingCardDetails" android:layout_width="100dp" android:layout_height="wrap_content" android:background="@drawable/bg_view_details_blue" android:gravity="center" android:text="@string/btn_view_details" android:textColor="#1463D9" android:textSize="14sp" android:textStyle="bold" android:minHeight="44dp" android:minWidth="@dimen/touch_target_size" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>

            