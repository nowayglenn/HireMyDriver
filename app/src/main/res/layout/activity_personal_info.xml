<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- TOP HEADER -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#001B43"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:tag="screen_header"
        android:minHeight="@dimen/screen_header_min_height" >

        <ImageButton
            android:id="@+id/btnPersonalBack"
            android:layout_width="@dimen/touch_target_size"
            android:layout_height="@dimen/touch_target_size"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FFFFFF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="@dimen/screen_header_icon_margin" />

        <TextView
            android:id="@+id/txtHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Personal Information"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/screen_header_title_size"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:tag="screen_header_title"
            android:layout_marginTop="@dimen/screen_header_title_gap"
            android:layout_marginBottom="@dimen/screen_header_title_gap"
            android:layout_marginStart="@dimen/screen_header_title_gap"
            android:layout_marginEnd="@dimen/screen_header_text_inset"
            app:layout_constraintStart_toEndOf="@id/btnPersonalBack"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="start|center_vertical" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- MAIN CONTENT -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="24dp">

            <!-- STEP PROCESS -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/stepContainer"
                android:layout_width="match_parent"
                android:layout_height="82dp">

                <TextView
                    android:id="@+id/step1"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_step_completed"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/step2"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_step_active"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/step1"
                    app:layout_constraintEnd_toStartOf="@id/step3"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintHorizontal_chainStyle="spread" />

                <TextView
                    android:id="@+id/step3"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_step_inactive"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/step2"
                    app:layout_constraintEnd_toStartOf="@id/step4"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/step4"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_step_inactive"
                    android:gravity="center"
                    android:text="4"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/line1"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:background="#D9DEE7"
                    app:layout_constraintStart_toEndOf="@id/step1"
                    app:layout_constraintEnd_toStartOf="@id/step2"
                    app:layout_constraintTop_toTopOf="@id/step1"
                    app:layout_constraintBottom_toBottomOf="@id/step1" />

                <View
                    android:id="@+id/line2"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:background="#D9DEE7"
                    app:layout_constraintStart_toEndOf="@id/step2"
                    app:layout_constraintEnd_toStartOf="@id/step3"
                    app:layout_constraintTop_toTopOf="@id/step2"
                    app:layout_constraintBottom_toBottomOf="@id/step2" />

                <View
                    android:id="@+id/line3"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:background="#D9DEE7"
                    app:layout_constraintStart_toEndOf="@id/step3"
                    app:layout_constraintEnd_toStartOf="@id/step4"
                    app:layout_constraintTop_toTopOf="@id/step3"
                    app:layout_constraintBottom_toBottomOf="@id/step3" />

                <TextView
                    android:id="@+id/labelStep1"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="Account"
                    android:textColor="#001B43"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@id/step1"
                    app:layout_constraintEnd_toEndOf="@id/step1"
                    app:layout_constraintTop_toBottomOf="@id/step1" />

                <TextView
                    android:id="@+id/labelStep2"
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:text="Personal Info"
                    android:textColor="#FF8A00"
                    android:textSize="9sp"
                    app:layout_constraintStart_toStartOf="@id/step2"
                    app:layout_constraintEnd_toEndOf="@id/step2"
                    app:layout_constraintTop_toBottomOf="@id/step2" />

                <TextView
                    android:id="@+id/labelStep3"
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:text="License Info"
                    android:textColor="#687386"
                    android:textSize="9sp"
                    app:layout_constraintStart_toStartOf="@id/step3"
                    app:layout_constraintEnd_toEndOf="@id/step3"
                    app:layout_constraintTop_toBottomOf="@id/step3" />

                <TextView
                    android:id="@+id/labelStep4"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:text="Review"
                    android:textColor="#687386"
                    android:textSize="9sp"
                    app:layout_constraintStart_toStartOf="@id/step4"
                    app:layout_constraintEnd_toEndOf="@id/step4"
                    app:layout_constraintTop_toBottomOf="@id/step4" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- FORM -->
            <LinearLayout
                android:id="@+id/personalInfoForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/txtPersonalInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/personal_info_header"
                    android:textColor="#273142"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtPersonalSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/personal_info_label"
                    android:textColor="#687386"
                    android:textSize="13sp" />

                <!-- DATE OF BIRTH -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Date of Birth"
                    android:textColor="#273142"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutDateOfBirth"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Date of Birth"
                    app:boxBackgroundColor="#F8F9FB"
                    app:boxCornerRadiusBottomEnd="7dp"
                    app:boxCornerRadiusBottomStart="7dp"
                    app:boxCornerRadiusTopEnd="7dp"
                    app:boxCornerRadiusTopStart="7dp"
                    app:boxStrokeColor="#8E99A9"
                    app:hintTextColor="#687386"
                    app:startIconDrawable="@drawable/ic_calendar"
                    app:startIconTint="#687386">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtDateOfBirth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:gravity="center_vertical"
                        android:textColor="#273142"
                        android:textSize="14sp"
                        android:singleLine="true"
                        android:focusable="false"
                        android:clickable="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- ADDRESS -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Address"
                    android:textColor="#273142"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutAddress"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Address"
                    app:expandedHintEnabled="false"
                    app:placeholderText="@string/driver_address_example"
                    app:boxBackgroundColor="#F8F9FB"
                    app:boxCornerRadiusBottomEnd="7dp"
                    app:boxCornerRadiusBottomStart="7dp"
                    app:boxCornerRadiusTopEnd="7dp"
                    app:boxCornerRadiusTopStart="7dp"
                    app:boxStrokeColor="#8E99A9"
                    app:hintTextColor="#687386"
                    app:startIconDrawable="@drawable/ic_location"
                    app:startIconTint="#687386">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:gravity="center_vertical"
                        android:textColor="#273142"
                        android:textSize="14sp"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- PROFILE PICTURE -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Profile Picture"
                    android:textColor="#273142"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="78dp"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgProfile"
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/CircleImage"
                        android:src="@drawable/no_profile"
                        app:strokeColor="#EEF0F3"
                        app:strokeWidth="1dp" />
                    <LinearLayout
                        android:id="@+id/btnTakeSelfie"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_upload_photo"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="78dp" >
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_camera"
                            android:contentDescription="Take selfie"
                            app:tint="#687386" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Live Selfie"
                            android:textColor="#687386"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- EXPERIENCE -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Years of Driving Experience"
                    android:textColor="#273142"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutExperience"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Years of Driving Experience"
                    app:boxBackgroundColor="#F8F9FB"
                    app:boxCornerRadiusBottomEnd="7dp"
                    app:boxCornerRadiusBottomStart="7dp"
                    app:boxCornerRadiusTopEnd="7dp"
                    app:boxCornerRadiusTopStart="7dp"
                    app:boxStrokeColor="#8E99A9"
                    app:hintTextColor="#687386">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtExperience"
                        android:inputType="number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:gravity="center_vertical"
                        android:textColor="#273142"
                        android:textSize="14sp"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- BIO -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Short Description / Bio"
                    android:textColor="#273142"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutBio"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Short Description / Bio"
                    app:expandedHintEnabled="false"
                    app:placeholderText="@string/driver_bio_example"
                    app:boxBackgroundColor="#F8F9FB"
                    app:boxCornerRadiusBottomEnd="7dp"
                    app:boxCornerRadiusBottomStart="7dp"
                    app:boxCornerRadiusTopEnd="7dp"
                    app:boxCornerRadiusTopStart="7dp"
                    app:boxStrokeColor="#8E99A9"
                    app:hintTextColor="#687386">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtBio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="110dp"
                        android:gravity="top"
                        android:padding="12dp"
                        android:textColor="#273142"
                        android:textSize="14sp"
                        android:inputType="textMultiLine"
                        android:maxLines="5"
                        android:scrollbars="vertical" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPersonalNext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/btn_next"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/action_button_text_size"
                    android:textStyle="bold"
                    app:backgroundTint="#FF8A00"
                    app:cornerRadius="7dp"
                    android:minHeight="@dimen/action_button_min_height"
                    android:gravity="center"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="false" />

                <TextView
                    android:id="@+id/btnPersonalBackBottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/btn_back"
                    android:textColor="#FF8A00"
                    android:textSize="@dimen/action_button_text_size"
                    android:textStyle="bold"
                    android:minHeight="@dimen/action_button_min_height"
                    android:minWidth="@dimen/touch_target_size" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
