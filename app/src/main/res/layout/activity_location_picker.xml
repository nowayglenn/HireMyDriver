<?xml version="1.0" ?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/mapFlowScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFFFFF">
        <FrameLayout android:id="@+id/mapArea" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#EDF1EA">
            <FrameLayout android:id="@+id/mapCanvas" android:layout_width="match_parent" android:layout_height="match_parent"/>
            <ImageView android:id="@+id/centerPickerPin" android:layout_width="40dp" android:layout_height="48dp" android:layout_gravity="center" android:translationY="-24dp" android:src="@drawable/ic_trip_center_pin" android:importantForAccessibility="no"/>
            <LinearLayout android:id="@+id/mapOverlayContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:id="@+id/mapFloatingHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="16dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btnBack" style="@style/MapFlowIconButton" android:src="@drawable/ic_arrow_back" android:contentDescription="Back"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:padding="12dp" android:orientation="vertical" android:background="@drawable/bg_map_flow_control">
                        <TextView style="@style/MapFlowEyebrow" android:text="BOOK YOUR DRIVER"/>
                        <TextView android:id="@+id/txtMapTitle" style="@style/MapFlowText" android:text="Set pickup" android:layout_marginTop="3dp" android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btnPickerExpand" style="@style/MapFlowIconButton" android:src="@drawable/ic_map_flow_expand" android:contentDescription="Full-screen map"/>
                </LinearLayout>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/btnMyLocation" style="@style/MapFlowIconButton" android:src="@drawable/ic_my_location" android:contentDescription="Use my location" android:layout_gravity="bottom|end" android:layout_marginEnd="16dp" android:layout_marginBottom="52dp"/>
        </FrameLayout>
        <androidx.core.widget.NestedScrollView android:id="@+id/mapBottomSheet" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@drawable/bg_map_flow_sheet" android:clipToOutline="true" app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior" app:behavior_peekHeight="84dp" app:behavior_hideable="true" app:behavior_fitToContents="false" app:behavior_halfExpandedRatio="0.52">
        <LinearLayout android:id="@+id/pickerPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_map_flow_sheet" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="10dp" android:paddingBottom="24dp">
            <com.google.android.material.bottomsheet.BottomSheetDragHandleView android:layout_width="match_parent" android:layout_height="32dp" android:layout_gravity="center_horizontal" android:layout_marginBottom="8dp" android:contentDescription="Drag to show or hide map details"/>
            <TextView android:id="@+id/txtPickerStep" style="@style/MapFlowEyebrow" android:text="01 · PICKUP"/>
            <TextView android:id="@+id/txtPickerHeading" style="@style/MapFlowHeading" android:text="Where should we meet?"/>
            <TextView style="@style/MapFlowCaption" android:text="Move the map until the pin is in the right spot."/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_location" android:padding="10dp" android:background="@drawable/bg_driver_trip_warning" app:tint="#FF7900" android:importantForAccessibility="no"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView android:id="@+id/txtSelectedPlace" style="@style/MapFlowText" android:text="Selected map location" android:fontFamily="sans-serif-medium"/>
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/txtLandmarkLabel" style="@style/MapFlowCaption" android:text="Place name or landmark" android:layout_marginTop="20dp"/>
            <EditText android:id="@+id/edtPlaceLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp" android:layout_marginTop="7dp" android:background="@drawable/bg_map_flow_field" android:fontFamily="sans-serif" android:textSize="15sp" android:textColor="#102444" android:textColorHint="#8995A5" android:padding="14dp" android:inputType="textCapSentences" android:imeOptions="actionDone" android:maxLength="160" android:hint="e.g. Main entrance, beside the gate" android:autofillHints="postalAddress"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnConfirmPin" style="@style/MapFlowButton" android:text="Confirm pickup" android:layout_marginTop="22dp" android:enabled="false"/>
            <TextView style="@style/MapFlowCaption" android:text="Check the pin before confirming" android:layout_marginTop="12dp" android:gravity="center"/>
        </LinearLayout>
        </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
