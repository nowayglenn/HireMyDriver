<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FB">

    <!-- HEADER -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#061B41"
        app:layout_constraintTop_toTopOf="parent"
        android:minHeight="@dimen/screen_header_min_height"
        android:tag="screen_header" >

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_target_size"
            android:layout_height="@dimen/touch_target_size"
            android:layout_marginStart="@dimen/screen_header_icon_margin"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@android:color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Driving Information"
            android:textColor="@android:color/white"
            android:textSize="@dimen/screen_header_title_size"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="@dimen/screen_header_text_inset"
            android:layout_marginVertical="@dimen/screen_header_title_gap"
            app:layout_constraintEnd_toEndOf="parent"
            android:tag="screen_header_title" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- CONTENT SCROLLVIEW -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="always"
        android:clipToPadding="false"
        android:clipChildren="false"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/bottomArea">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:clipToPadding="false"
            android:clipChildren="false">

            <!-- 1. VEHICLE TYPES I CAN DRIVE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vehicle Types I Can Drive"
                    android:textColor="#061B41"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Select all that apply."
                    android:textColor="#667085"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Vehicle Types Grid Row 1 (All, Sedan, SUV) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <!-- All -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAll"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="1dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="8dp">

                        <androidx.appcompat.widget.AppCompatCheckBox
                            android:id="@+id/chkAll" android:contentDescription="All vehicle types"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="top|end"
                            android:checked="false"
                            android:button="@drawable/selector_vehicle_checkbox" android:buttonTint="@null" app:buttonTint="@null" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_vehicle"
                                app:tint="#061B41" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="All"
                                android:textColor="#061B41"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Sedan (Selected) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSedan"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFF3E0"
                    app:strokeColor="#FF7900"
                    app:strokeWidth="1.5dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="8dp">

                        <androidx.appcompat.widget.AppCompatCheckBox
                            android:id="@+id/chkSedan" android:contentDescription="Sedan"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="top|end"
                            android:checked="true"
                            android:button="@drawable/selector_vehicle_checkbox" android:buttonTint="@null" app:buttonTint="@null" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_vehicle"
                                app:tint="#061B41" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Sedan"
                                android:textColor="#061B41"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- SUV (Selected) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSuv"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFF3E0"
                    app:strokeColor="#FF7900"
                    app:strokeWidth="1.5dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="8dp">

                        <androidx.appcompat.widget.AppCompatCheckBox
                            android:id="@+id/chkSuv" android:contentDescription="SUV"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="top|end"
                            android:checked="true"
                            android:button="@drawable/selector_vehicle_checkbox" android:buttonTint="@null" app:buttonTint="@null" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_vehicle"
                                app:tint="#061B41" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="SUV"
                                android:textColor="#061B41"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Vehicle Types Grid Row 2 (Van, Pickup, Truck) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <!-- Van -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVan"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="1dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="8dp">

                        <androidx.appcompat.widget.AppCompatCheckBox
                            android:id="@+id/chkVan" android:contentDescription="Van"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="top|end"
                            android:checked="false"
                            android:button="@drawable/selector_vehicle_checkbox" android:buttonTint="@null" app:buttonTint="@null" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_vehicle"
                                app:tint="#061B41" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Van"
                                android:textColor="#061B41"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Pickup -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPickup"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="1dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="8dp">

                        <androidx.appcompat.widget.AppCompatCheckBox
                            android:id="@+id/chkPickup" android:contentDescription="Pickup"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="top|end"
                            android:checked="false"
                            android:button="@drawable/selector_vehicle_checkbox" android:buttonTint="@null" app:buttonTint="@null" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_vehicle"
                                app:tint="#061B41" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Pickup"
                                android:textColor="#061B41"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Truck -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTruck"
                    android:layout_width="0dp"
                    android:layout_height="76dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="1dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="8dp">

                        <androidx.appcompat.widget.AppCompatCheckBox
                            android:id="@+id/chkTruck" android:contentDescription="Truck"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="top|end"
                            android:checked="false"
                            android:button="@drawable/selector_vehicle_checkbox" android:buttonTint="@null" app:buttonTint="@null" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_vehicle"
                                app:tint="#061B41" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Truck"
                                android:textColor="#061B41"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- 2. TRANSMISSION I CAN DRIVE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Transmission I Can Drive"
                    android:textColor="#061B41"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Select all that apply."
                    android:textColor="#667085"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Transmission Cards Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <!-- Automatic -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAutomatic"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFF3E0"
                    app:strokeColor="#FF7900"
                    app:strokeWidth="1.5dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_driver_circle"
                            android:backgroundTint="#061B41"
                            android:gravity="center"
                            android:text="A"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="Automatic"
                            android:textColor="#061B41"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatCheckBox
                            android:id="@+id/chkAutomatic" android:contentDescription="Automatic transmission"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:checked="true"
                            android:button="@drawable/selector_vehicle_checkbox" android:buttonTint="@null" app:buttonTint="@null" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Manual -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardManual"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFF3E0"
                    app:strokeColor="#FF7900"
                    app:strokeWidth="1.5dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_driver_circle"
                            android:backgroundTint="#061B41"
                            android:gravity="center"
                            android:text="M"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="Manual"
                            android:textColor="#061B41"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatCheckBox
                            android:id="@+id/chkManual" android:contentDescription="Manual transmission"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:checked="true"
                            android:button="@drawable/selector_vehicle_checkbox" android:buttonTint="@null" app:buttonTint="@null" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- 3. YEARS OF DRIVING EXPERIENCE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Years of Driving Experience"
                    android:textColor="#061B41"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Type the number of years."
                    android:textColor="#667085"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dropdown"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="24dp"
                android:minHeight="52dp" >

                <EditText
                    android:id="@+id/edtExperience"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:inputType="number"
                    android:text="5"
                    android:textColor="#061B41"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="years"
                    android:textColor="#667085"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- 4. PREFERRED SERVICE AREA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Preferred Service Area"
                    android:textColor="#061B41"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Select all areas where you are willing to accept bookings."
                    android:textColor="#667085"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnServiceArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dropdown"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="24dp"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="@dimen/action_button_min_height" >

                <TextView
                    android:id="@+id/txtServiceArea"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cebu City, Mandaue City, Lapu-Lapu City"
                    android:textColor="#061B41"
                    android:textSize="14sp"
                    android:ellipsize="end"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#9CA3AF"
                    android:textSize="22sp"
                    android:layout_weight="1"
                    android:gravity="end|center_vertical" />

            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Languages Spoken" android:textColor="#061B41" android:textSize="17sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="8dp" android:layout_marginBottom="24dp">
                <CheckBox android:id="@+id/chkFilipino" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Filipino" android:textColor="#061B41" android:textSize="14sp"
                    android:minHeight="48dp" android:drawablePadding="12dp" android:button="@drawable/selector_vehicle_checkbox"
                    android:buttonTint="@null" app:buttonTint="@null" />
                <CheckBox android:id="@+id/chkEnglish" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="English" android:textColor="#061B41" android:textSize="14sp"
                    android:minHeight="48dp" android:drawablePadding="12dp" android:button="@drawable/selector_vehicle_checkbox"
                    android:buttonTint="@null" app:buttonTint="@null" />
                <CheckBox android:id="@+id/chkCebuano" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Cebuano/Bisaya" android:textColor="#061B41" android:textSize="14sp"
                    android:minHeight="48dp" android:drawablePadding="12dp" android:button="@drawable/selector_vehicle_checkbox"
                    android:buttonTint="@null" app:buttonTint="@null" />
            </LinearLayout>

            <!-- 5. HOURLY RATE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hourly Rate"
                    android:textColor="#061B41"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Set your base hourly rate for driving services."
                    android:textColor="#667085"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dropdown"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="12dp"
                android:minHeight="52dp" >

                <EditText
                    android:id="@+id/edtHourlyRate"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:inputType="number"
                    android:text="300"
                    android:textColor="#061B41"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₱ / hour"
                    android:textColor="#667085"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Hourly Rate Info Box -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#EFF6FF"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#BFDBFE"
                app:strokeWidth="1dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_help"
                        app:tint="#1D4ED8" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:lineSpacingExtra="3dp"
                        android:text="• This is your base rate.\n• Customers will see this hourly rate on your profile.\n• You can update it anytime."
                        android:textColor="#1D4ED8"
                        android:textSize="13sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- SAVE CHANGES BUTTON -->
    <LinearLayout
        android:id="@+id/bottomArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveChanges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Changes"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/action_button_text_size"
            android:textStyle="bold"
            app:backgroundTint="#FF7900"
            app:cornerRadius="10dp"
            android:minHeight="@dimen/action_button_min_height"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:singleLine="false"
            android:gravity="center" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

