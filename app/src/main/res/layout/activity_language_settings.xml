<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA">

    <!-- HEADER -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#061B41"
        app:layout_constraintTop_toTopOf="parent"
        android:tag="screen_header"
        android:minHeight="@dimen/screen_header_min_height" >

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_target_size"
            android:layout_height="@dimen/touch_target_size"
            android:layout_marginStart="@dimen/screen_header_icon_margin"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@android:color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_header_title_gap"
            android:text="@string/language_title"
            android:textColor="@android:color/white"
            android:textSize="@dimen/screen_header_title_size"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:tag="screen_header_title"
            android:layout_marginTop="@dimen/screen_header_title_gap"
            android:layout_marginBottom="@dimen/screen_header_title_gap"
            android:layout_marginEnd="@dimen/screen_header_text_inset"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="start|center_vertical" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_preferred_language"
            android:textColor="#667085"
            android:textSize="14sp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <RadioGroup
                android:id="@+id/radioGroupLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- English -->
                <RadioButton
                    android:id="@+id/rbEnglish"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:gravity="start|center_vertical"
                    android:paddingVertical="16dp"
                    android:drawablePadding="16dp"
                    android:background="?attr/selectableItemBackground"
                    android:button="@null"
                    android:checked="true"
                    android:drawableEnd="@drawable/radio_selector"
                    android:paddingHorizontal="20dp"
                    android:text="@string/lang_english"
                    android:textColor="#061B41"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F2F4F7" android:layout_marginHorizontal="20dp" />

                <!-- Tagalog -->
                <RadioButton
                    android:id="@+id/rbTagalog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:gravity="start|center_vertical"
                    android:paddingVertical="16dp"
                    android:drawablePadding="16dp"
                    android:background="?attr/selectableItemBackground"
                    android:button="@null"
                    android:drawableEnd="@drawable/radio_selector"
                    android:paddingHorizontal="20dp"
                    android:text="@string/lang_tagalog"
                    android:textColor="#061B41"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F2F4F7" android:layout_marginHorizontal="20dp" />

                <!-- Ilocano -->
                <RadioButton
                    android:id="@+id/rbIlocano"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:gravity="start|center_vertical"
                    android:paddingVertical="16dp"
                    android:drawablePadding="16dp"
                    android:background="?attr/selectableItemBackground"
                    android:button="@null"
                    android:drawableEnd="@drawable/radio_selector"
                    android:paddingHorizontal="20dp"
                    android:text="@string/lang_ilocano"
                    android:textColor="#061B41"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </RadioGroup>
        </androidx.cardview.widget.CardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/btn_save_selection"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/action_button_text_size"
            android:textStyle="bold"
            app:backgroundTint="#FF7900"
            app:cornerRadius="12dp"
            android:minHeight="@dimen/action_button_min_height"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="false" />

    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>