<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA">


    <!-- ===================================================== -->
    <!-- TOP HEADER -->
    <!-- ===================================================== -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#061B41"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:tag="screen_header"
        android:minHeight="@dimen/screen_header_min_height" >


        <!-- TITLE -->

        <TextView
            android:id="@+id/txtHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/my_bookings_title"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/screen_header_title_size"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:tag="screen_header_title"
            android:layout_marginTop="@dimen/screen_header_title_gap"
            android:layout_marginBottom="@dimen/screen_header_title_gap"
            android:layout_marginStart="@dimen/screen_header_text_inset"
            android:layout_marginEnd="@dimen/screen_header_text_inset"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="start|center_vertical" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ===================================================== -->
    <!-- MAIN CONTENT -->
    <!-- ===================================================== -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/bookingScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="always"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp"
            android:clipChildren="false"
            android:clipToPadding="false">
            <LinearLayout android:id="@+id/localTripsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" />


            <!-- ================================================= -->
            <!-- FILTER TABS -->
            <!-- ================================================= -->

            <HorizontalScrollView
                android:id="@+id/filterScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">


                    <!-- ALL -->

                    <TextView
                        android:id="@+id/tabAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_tab_active"
                        android:gravity="center"
                        android:text="@string/tab_all"
                        android:textColor="#FF7A00"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:minHeight="44dp" />


                    <!-- PENDING -->

                    <TextView
                        android:id="@+id/tabPending"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_tab"
                        android:gravity="center"
                        android:text="@string/tab_pending"
                        android:textColor="#344054"
                        android:textSize="13sp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:minHeight="44dp" />


                    <!-- ACCEPTED -->

                    <TextView
                        android:id="@+id/tabAccepted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_tab"
                        android:gravity="center"
                        android:text="@string/tab_accepted"
                        android:textColor="#344054"
                        android:textSize="13sp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:minHeight="44dp" />


                    <!-- COMPLETED -->

                    <TextView
                        android:id="@+id/tabCompleted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_tab"
                        android:gravity="center"
                        android:text="@string/tab_completed"
                        android:textColor="#344054"
                        android:textSize="13sp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:minHeight="44dp" />


                    <!-- CANCELLED -->

                    <TextView
                        android:id="@+id/tabCancelled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tab"
                        android:gravity="center"
                        android:text="@string/tab_cancelled"
                        android:textColor="#344054"
                        android:textSize="13sp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:minHeight="44dp" />

                </LinearLayout>

            </HorizontalScrollView>


            <!-- ================================================= -->
            <!-- PENDING SECTION -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/sectionPending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical">


                <!-- SECTION HEADER -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/tab_pending"
                        android:textColor="#061B41"
                        android:textSize="16sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/txtPendingCount"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_count_orange"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#FF7A00"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- PENDING CARD -->

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardPending"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardUseCompatPadding="true">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">


                            <!-- PROFILE -->

                            <ImageView
                                android:layout_width="54dp"
                                android:layout_height="54dp"
                                android:background="@drawable/bg_pending_icon"
                                android:contentDescription="Customer"
                                android:padding="14dp"
                                android:src="@drawable/icons_profile"
                                app:tint="#FF7A00" />


                            <!-- DETAILS -->

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Juan Dela Cruz"
                                    android:textColor="#061B41"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="May 20, 2025 • 08:30 AM"
                                    android:textColor="#667085"
                                    android:textSize="11sp" />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="Cebu City → Mandaue City"
                                    android:textColor="#344054"
                                    android:textSize="11sp" />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="By the hour • 4 hours"
                                    android:textColor="#667085"
                                    android:textSize="11sp" />

                            </LinearLayout>


                            <!-- STATUS -->

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_status_pending"
                                android:paddingStart="8dp"
                                android:paddingTop="5dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="5dp"
                                android:text="@string/status_pending"
                                android:textColor="#FF7A00"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                        </LinearLayout>


                        <!-- DIVIDER -->

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:background="#EEF0F3" />


                        <!-- BOTTOM -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">


                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="₱2,000.00"
                                android:textColor="#061B41"
                                android:textSize="17sp"
                                android:textStyle="bold" />


                            <TextView
                                android:id="@+id/btnPendingDetails"
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_view_details_orange"
                                android:gravity="center"
                                android:text="View Details"
                                android:textColor="#FF7A00"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:minHeight="44dp"
                                android:minWidth="@dimen/touch_target_size" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- ACCEPTED SECTION -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/sectionAccepted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">


                <!-- SECTION HEADER -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/tab_accepted"
                        android:textColor="#061B41"
                        android:textSize="16sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/txtAcceptedCount"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_count_blue"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#1463D9"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- ACCEPTED CARD -->

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardAccepted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardUseCompatPadding="true">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">


                            <com.google.android.material.imageview.ShapeableImageView
                                android:layout_width="54dp"
                                android:layout_height="54dp"
                                android:background="@drawable/bg_accepted_icon"
                                android:contentDescription="Customer"
                                android:scaleType="centerCrop"
                                android:src="@drawable/laur"
                                app:shapeAppearanceOverlay="@style/CircleImage"
                                app:tint="@null" />


                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Mark Laurence Polinar"
                                    android:textColor="#061B41"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="★ 4.9"
                                    android:textColor="#FF7A00"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="May 25, 2025 • 08:00 AM"
                                    android:textColor="#667085"
                                    android:textSize="11sp" />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="Cebu City → Mandaue City"
                                    android:textColor="#344054"
                                    android:textSize="11sp" />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="10 years experience • Sedan, SUV"
                                    android:textColor="#667085"
                                    android:textSize="11sp" />

                            </LinearLayout>


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_match_badge"
                                android:paddingStart="8dp"
                                android:paddingTop="5dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="5dp"
                                android:text="@string/status_on_trip"
                                android:textColor="#159447"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- TRACK & EMERGENCY BUTTONS -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:id="@+id/btnTrackTrip"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_btn_track"
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:clickable="true"
                                android:focusable="true"
                                android:minHeight="44dp" >
                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_location"
                                    app:tint="#1463D9" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="@string/btn_track_trip"
                                    android:textColor="#1463D9"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/btnEmergencyAccepted"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/bg_btn_emergency_outline"
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:clickable="true"
                                android:focusable="true"
                                android:minHeight="44dp" >
                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_siren"
                                    app:tint="#F04438" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="@string/btn_emergency"
                                    android:textColor="#F04438"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>


                        <!-- DIVIDER -->

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:background="#EEF0F3" />


                        <!-- BOTTOM -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">


                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="₱2,600.00"
                                android:textColor="#061B41"
                                android:textSize="17sp"
                                android:textStyle="bold" />


                            <TextView
                                android:id="@+id/btnAcceptedDetails"
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_view_details_blue"
                                android:gravity="center"
                                android:text="@string/btn_view_details"
                                android:textColor="#1463D9"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:minHeight="44dp"
                                android:minWidth="@dimen/touch_target_size" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- COMPLETED SECTION -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/sectionCompleted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/tab_completed"
                        android:textColor="#061B41"
                        android:textSize="16sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/txtCompletedCount"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_count_green"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#159447"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCompleted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardUseCompatPadding="true">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">


                            <ImageView
                                android:layout_width="54dp"
                                android:layout_height="54dp"
                                android:background="@drawable/bg_completed_icon"
                                android:contentDescription="Customer"
                                android:padding="14dp"
                                android:src="@drawable/icons_profile"
                                app:tint="#159447" />


                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Rafael Reyes"
                                    android:textColor="#061B41"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="May 10, 2025 • 06:00 PM"
                                    android:textColor="#667085"
                                    android:textSize="11sp" />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="Cebu City → Lapu-Lapu City"
                                    android:textColor="#344054"
                                    android:textSize="11sp" />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="Multiple Days • 3 days"
                                    android:textColor="#667085"
                                    android:textSize="11sp" />

                            </LinearLayout>


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_status_completed"
                                android:paddingStart="8dp"
                                android:paddingTop="5dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="5dp"
                                android:text="@string/status_completed"
                                android:textColor="#159447"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                        </LinearLayout>


                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:background="#EEF0F3" />


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">


                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="₱7,500.00"
                                android:textColor="#061B41"
                                android:textSize="17sp"
                                android:textStyle="bold" />


                            <TextView
                                android:id="@+id/btnCompletedDetails"
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_view_details_green"
                                android:gravity="center"
                                android:text="View Details"
                                android:textColor="#159447"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:minHeight="44dp"
                                android:minWidth="@dimen/touch_target_size" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- CANCELLED SECTION -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/sectionCancelled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/tab_cancelled"
                        android:textColor="#061B41"
                        android:textSize="16sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/txtCancelledCount"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_count_red"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#E53935"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCancelled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardUseCompatPadding="true">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">


                            <ImageView
                                android:layout_width="54dp"
                                android:layout_height="54dp"
                                android:background="@drawable/bg_cancelled_icon"
                                android:contentDescription="Customer"
                                android:padding="14dp"
                                android:src="@drawable/icons_profile"
                                app:tint="#E53935" />


                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Angela Lopez"
                                    android:textColor="#061B41"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="May 5, 2025 • 02:00 PM"
                                    android:textColor="#667085"
                                    android:textSize="11sp" />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="Cebu City → Mandaue City"
                                    android:textColor="#344054"
                                    android:textSize="11sp" />


                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="By the hour • 2 hours"
                                    android:textColor="#667085"
                                    android:textSize="11sp" />

                            </LinearLayout>


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_status_cancelled"
                                android:paddingStart="8dp"
                                android:paddingTop="5dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="5dp"
                                android:text="@string/status_cancelled"
                                android:textColor="#E53935"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                        </LinearLayout>


                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:background="#EEF0F3" />


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">


                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="₱1,800.00"
                                android:textColor="#061B41"
                                android:textSize="17sp"
                                android:textStyle="bold" />


                            <TextView
                                android:id="@+id/btnCancelledDetails"
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_view_details_red"
                                android:gravity="center"
                                android:text="View Details"
                                android:textColor="#E53935"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:minHeight="44dp"
                                android:minWidth="@dimen/touch_target_size" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- ===================================================== -->
    <!-- BOTTOM NAVIGATION -->
    <!-- SAME STRUCTURE AS YOUR HOME CODE -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:background="#FFFFFF"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- HOME -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/iconHome"
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp"
                android:src="@drawable/icons_home"
                app:tint="#68717E" />
            <TextView android:gravity="center" android:maxLines="2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_home"
                android:textColor="#68717E"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- BOOKINGS (ACTIVE) -->
        <LinearLayout
            android:id="@+id/navBookings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/iconBookings"
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_nav_active"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp"
                android:src="@drawable/icons_calendar"
                app:tint="#FF7A00" />
            <TextView android:gravity="center" android:maxLines="2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_bookings"
                android:textColor="#FF7A00"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- MESSAGES -->
        <LinearLayout
            android:id="@+id/navMessages"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/iconMessages"
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp"
                android:src="@drawable/icons_message"
                app:tint="#68717E" />
            <TextView android:gravity="center" android:maxLines="2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_messages"
                android:textColor="#68717E"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- PROFILE -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/iconProfile"
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp"
                android:src="@drawable/icons_profile"
                app:tint="#68717E" />
            <TextView android:gravity="center" android:maxLines="2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_profile"
                android:textColor="#68717E"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>