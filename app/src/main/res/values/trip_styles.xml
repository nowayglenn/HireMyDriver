<resources>
    <style name="TripButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/action_button_min_height</item><item name="android:textSize">@dimen/action_button_text_size</item>
        <item name="android:textAllCaps">false</item><item name="android:textColor">#FFFFFF</item><item name="backgroundTint">#FF7900</item>
        <item name="cornerRadius">14dp</item><item name="android:padding">12dp</item><item name="android:insetTop">0dp</item><item name="android:insetBottom">0dp</item>
    </style>
    <style name="TripButton.Outline" parent="TripButton">
        <item name="android:textColor">#061B41</item><item name="backgroundTint">#FFFFFF</item><item name="strokeColor">#DDE4EE</item><item name="strokeWidth">1dp</item>
    </style>
    <style name="TripText"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textSize">14sp</item><item name="android:textColor">#667085</item></style>
</resources>
